<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Fabrikam.EnterprisePizza.Portal.SiteMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Fabrikam Enterprise Pizza Partner Portal</title>
    <link href="Content/Site.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="Scripts/portal.js"></script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="PortalForm" runat="server">
        <asp:ScriptManager ID="PortalScriptManager" runat="server" EnablePageMethods="true" />
        <div class="page-shell">
            <div class="utility-nav">
                <a href="Default.aspx">Portal Home</a>
                <a href="OperationsSnapshot.aspx">Operations Snapshot</a>
                <a href="/CustomerHub/CorporateAccounts.aspx">Corporate Accounts</a>
                <a href="/FranchisePortal/Default.aspx">Franchise Bulletins</a>
                <a href="/Storefront/">Storefront</a>
            </div>
            <div class="masthead">
                <div class="logo-block">
                    <span class="logo-mark">F</span>
                    <div class="logo-copy">
                        <h1>Fabrikam Enterprise Pizza</h1>
                        <p>Partner portal for district managers, franchise operators, and catering support.</p>
                    </div>
                </div>
                <div class="hero-note">
                    Hot slices. Corporate precision.
                </div>
            </div>
            <div class="tab-strip">
                <a href="Default.aspx">Executive Snapshot</a>
                <a href="OperationsSnapshot.aspx">Store Rollups</a>
                <span class="status-chip">Trusted Partner Access</span>
            </div>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            <div class="footer">
                <div>Questions? Fax updated catering forms to HQ intake before 4:00 PM.</div>
                <div class="footer-links">
                    <a href="#">Contact</a>
                    <a href="#">Privacy</a>
                    <a href="#">Careers</a>
                    <a href="#">MySpace</a>
                </div>
                <div class="best-viewed">Best viewed at 1024 x 768 with JavaScript enabled.</div>
            </div>
        </div>
    </form>
</body>
</html>
