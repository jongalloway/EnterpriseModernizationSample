<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="Fabrikam.EnterprisePizza.Services.DispatchHost.StoreDispatchService">
        <endpoint address="" binding="basicHttpBinding" contract="Fabrikam.EnterprisePizza.Services.DispatchHost.IStoreDispatchService" />
      </service>
    </services>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" />
  </system.serviceModel>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
