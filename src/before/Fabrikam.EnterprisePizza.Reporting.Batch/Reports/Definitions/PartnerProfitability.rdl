<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="FabrikamPizza_Reporting">
      <DataSourceReference>/Fabrikam Enterprise Pizza/Shared Data Sources/FabrikamPizza_Reporting</DataSourceReference>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>8f4594c4-6c7b-4be0-84c4-98fae4f8a245</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="SummaryDate"><DataType>DateTime</DataType><Prompt>Summary Date</Prompt><DefaultValue><Values><Value>=Today()</Value></Values></DefaultValue></ReportParameter>
    <ReportParameter Name="PartnerCode"><DataType>String</DataType><Prompt>Partner Code</Prompt><DefaultValue><Values><Value>ALL</Value></Values></DefaultValue></ReportParameter>
    <ReportParameter Name="MinimumGrossSales"><DataType>Float</DataType><Prompt>Minimum Gross Sales</Prompt><DefaultValue><Values><Value>0</Value></Values></DefaultValue></ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="PartnerProfitabilityDataSet">
      <Query>
        <DataSourceName>FabrikamPizza_Reporting</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.usp_PartnerProfitabilityReport_GetSummary</CommandText>
        <QueryParameters>
          <QueryParameter Name="@SummaryDate"><Value>=Parameters!SummaryDate.Value</Value></QueryParameter>
          <QueryParameter Name="@PartnerCode"><Value>=Parameters!PartnerCode.Value</Value></QueryParameter>
          <QueryParameter Name="@MinimumGrossSales"><Value>=Parameters!MinimumGrossSales.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="PartnerCode"><DataField>PartnerCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SummaryDate"><DataField>SummaryDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="DeliveredOrders"><DataField>DeliveredOrders</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="GrossSales"><DataField>GrossSales</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="FeePercentage"><DataField>FeePercentage</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="CommissionPayout"><DataField>CommissionPayout</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="NetRevenue"><DataField>NetRevenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="PartnerProfitabilityTitle"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Partner Profitability</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>0in</Top><Left>0in</Left><Height>0.3in</Height><Width>6.8in</Width><Style /></Textbox>
      <Tablix Name="PartnerProfitabilityTablix">
        <DataSetName>PartnerProfitabilityDataSet</DataSetName>
        <Top>0.45in</Top>
        <Left>0in</Left>
        <Height>0.55in</Height>
        <Width>6.9in</Width>
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
            <TablixColumn><Width>0.9in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>0.9in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>1.3in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow><Height>0.22in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="PartnerHdrCode"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Partner</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerHdrOrders"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Orders</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerHdrGross"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Gross Sales</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerHdrFee"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Fee %</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerHdrPayout"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Commission</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerHdrNet"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Net Revenue</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#dce6f2</BackgroundColor></Style></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
            <TablixRow><Height>0.22in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="PartnerCodeValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PartnerCode.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerOrdersValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DeliveredOrders.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerGrossValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=FormatCurrency(Fields!GrossSales.Value, 0)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerFeeValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=FormatNumber(Fields!FeePercentage.Value, 2) &amp; "%"</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerPayoutValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=FormatCurrency(Fields!CommissionPayout.Value, 0)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="PartnerNetValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=FormatCurrency(Fields!NetRevenue.Value, 0)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="PartnerProfitabilityDetailGroup" /></TablixMember></TablixMembers></TablixRowHierarchy>
      </Tablix>
    </ReportItems>
    <Height>1.2in</Height>
    <Style />
  </Body>
  <Width>6.9in</Width>
  <Page><PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth><LeftMargin>0.5in</LeftMargin><RightMargin>0.5in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin><Style /></Page>
