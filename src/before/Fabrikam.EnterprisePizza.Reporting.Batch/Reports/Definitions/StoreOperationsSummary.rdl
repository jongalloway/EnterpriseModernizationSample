        <Field Name="StaffingCoveragePercentage"><DataField>StaffingCoveragePercentage</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="StoreOperationsSummaryTitle"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Store Operations Summary</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>0in</Top><Left>0in</Left><Height>0.3in</Height><Width>6.8in</Width><Style /></Textbox>
      <Tablix Name="StoreOperationsSummaryTablix">
        <DataSetName>StoreOperationsSummaryDataSet</DataSetName>
