    <ReportParameter Name="EndDate"><DataType>DateTime</DataType><Prompt>End Date</Prompt><DefaultValue><Values><Value>=Today()</Value></Values></DefaultValue></ReportParameter>
    <ReportParameter Name="RollupMode"><DataType>String</DataType><Prompt>Rollup Mode</Prompt><DefaultValue><Values><Value>Daily</Value></Values></DefaultValue></ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="StoreOperationsSummaryDataSet">
      <Query>
        <DataSourceName>FabrikamPizza_Reporting</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.usp_StoreOperationsSummaryReport_GetRollup</CommandText>
        <QueryParameters>
          <QueryParameter Name="@StoreNumber"><Value>=Parameters!StoreNumber.Value</Value></QueryParameter>
          <QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter>
          <QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter>
          <QueryParameter Name="@RollupMode"><Value>=Parameters!RollupMode.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="StoreNumber"><DataField>StoreNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PeriodStart"><DataField>PeriodStart</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
