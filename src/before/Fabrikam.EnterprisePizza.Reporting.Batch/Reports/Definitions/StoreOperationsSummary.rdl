              <TablixCell><CellContents><Textbox Name="OpsCoverageValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=FormatNumber(Fields!StaffingCoveragePercentage.Value, 1) &amp; "%"</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
