            <TablixRow><Height>0.22in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="OpsPeriodValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!PeriodStart.Value, "yyyy-MM-dd")</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="OpsStoreValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!StoreNumber.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell>
