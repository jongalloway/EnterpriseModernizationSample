<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Fabrikam.EnterprisePizza.StoreOps.Portal.SiteMaster" %>
<!DOCTYPE html>
<html>
<head id="Head1" runat="server">
    <title>Fabrikam Enterprise Pizza Store Operations Portal</title>
    <meta http-equiv="X-UA-Compatible" content="IE=8" />
    <link href="Content/Portal.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="pageShell">
            <div class="pageHeader">
                <div class="brandLockup">
                    <span class="brandName">Fabrikam Enterprise Pizza</span>
                    <span class="brandDivider">|</span>
                    <span class="brandArea">Store Operations Portal</span>
                </div>
                <div class="brandMeta">Supervisor Terminal Certified for Store <span id="selectedStoreStamp">014</span></div>
            </div>

            <div class="utilityBar">
                <a href="Default.aspx">Dispatch Dashboard</a>
                <span class="navDivider">|</span>
                <a href="OrderLookup.aspx">Order Lookup</a>
                <span class="navDivider">|</span>
                <a href="OrderHistory.aspx">Order History</a>
                <span class="navDivider">|</span>
                <a href="Default.aspx#laborWatch">Labor Watch</a>
                <span class="navDivider">|</span>
                <a href="Default.aspx#zoneNotes">Zone Notes</a>
                <span class="terminalHint">Best viewed in Internet Explorer 8 at 1024 x 768.</span>
                <a href="#" id="legacyTipsToggle" class="tipsLink">Terminal tips</a>
            </div>

            <div id="legacyTips" class="legacyTips">
                <strong>Terminal reminders:</strong>
                Use Refresh Board after a driver reroute, print labor snapshots before shift change, and keep the dispatch monitor docked beside the desktop board during dinner rush.
            </div>

            <asp:ContentPlaceHolder ID="MainContent" runat="server" />

            <div class="pageFooter">
                <span>Fabrikam Enterprise Pizza intranet shell rev. 5.4</span>
                <span class="footerDivider">|</span>
                <span>Blue screen alert escalation line posted at every make-line terminal</span>
            </div>
        </div>
        <script src="Scripts/portal-shell.js" type="text/javascript"></script>
    </form>
</body>
</html>
